type
  List
  {
    int data;
    List next;
  }
  MarkList
  {
    int data;
    List marks;
    MarkList next;
  }
endtype

decl
    List head;
    MarkList mList;
enddecl

int main()
{
  decl
    int length, x;
    List p, q;
  enddecl

  begin
    mList.marks.data = 10;
    print(mList.marks.data);
    if (mList.marks.data > mList.next.marks.data) then
        print("first student performed better in the first subject");
    endif;
    return 1;
  end
}