decl
    int *p, *q;
    tuple student(
        str name, 
        int roll_no
    ) a, b, c, *ptr;
    int abc;
    str getName(tuple student(str name, int roll_no) *s);
    int getRollNo(tuple student(str name, int roll_no) s);
    int swap(int *a, int *b);
    int diff(int a, int b);
    int l, m;
    int arr[20];
enddecl

str getName(tuple student(str name, int roll_no) *s)
{
    decl
        str name;
        tuple student(str name, int roll_no) a;
    enddecl
    begin
        a = *s;
        name = a.name;
        return name;
    end
}

int getRollNo(tuple student(str name, int roll_no) s)
{
    decl
        int rollNo;
    enddecl
    begin
        rollNo = s.roll_no;
        return rollNo;
    end
}

int swap(int* a, int *b)
{
    begin
        *a = (*a)+(*b);
        *b = (*a)-(*b);
        *a = (*a)-(*b);
        return 0;
    end
}

int diff(int a, int b)
{
    decl
        int res;
    enddecl
    begin
        res = a-b;
        return res;
    end
}

int main() {
    decl
        int difference;
    enddecl
    begin
        read(a.name);
        read(a.roll_no);
        print(getRollNo(a));
        return 0;
    end
}